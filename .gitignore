node_modules

# Resultado del build de produccion (sesion 6).
dist
dist-ssr

# Variables de entorno locales. El archivo .env.example si se sube.
.env
.env.local
.env.*.local

# Registros de errores.
npm-debug.log*
yarn-debug.log*
*.log

# Archivos del editor y del sistema operativo.
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db

# PGlite data when PGLITE_DIR=.data is used
.data/
