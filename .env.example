# Copy to .env before starting. Vite only exposes variables prefixed with VITE_.
# Local API (npm run api). On Vercel the API lives under /api of the same site.
VITE_API_URL=http://localhost:3001/api

# Optional: a shared demo account for the "Ver demo" button on the login page.
# Only used when login is on (VITE_NEON_AUTH_URL). These values are public in the
# built site: use a throwaway account that holds nothing private.
# VITE_DEMO_EMAIL=
# VITE_DEMO_PASSWORD=
